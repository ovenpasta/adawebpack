--  Builds a command-line HAC compiler driver (hac_cli_main.adb) for wasm32.
--
--  Linked with -sNODERAWFS=1 (see the Makefile), the resulting hac_cli.js
--  behaves like the native `hac` binary: it reads argv, opens source and data
--  files on the real file system relative to the current directory, and exits
--  with the program's exit status. This lets HAC's own regression harness
--  (test/all_silent_tests) drive the wasm compiler unchanged, by using a thin
--  `hac` wrapper script that runs this module under node.

with "hac_common.gpr";

project HAC_CLI is

   for Target use HAC_Common'Target;
   for Runtime ("Ada") use HAC_Common'Runtime ("Ada");
   for Object_Dir use ".objs_cli";
   for Exec_Dir use ".";
   for Main use ("hac_cli_main.adb");

   --  HAC's own CLI (hac/src/apps: hac.adb + hac_pkg.adb) is not used:
   --  hac_cli_main.adb (in this directory) is a small wasm-oriented front end
   --  that wires up NODERAWFS and the search-path catalogue instead.
   for Source_Dirs use (".") & HAC_Common.HAC_Source_Dirs;

   package Compiler renames HAC_Common.Compiler;

   package Builder is
      for Executable ("hac_cli_main.adb") use "hac_cli.js";
   end Builder;

   --  Keep in sync with EMCC_CLI_FLAGS in the Makefile
   package Linker extends HAC_Common.Linker is
      for Switches ("Ada") use
        ("-O2", "-fwasm-exceptions", "-sALLOW_MEMORY_GROWTH=1",
         "-sSTACK_SIZE=16777216", "-sNODERAWFS=1", "-sEXIT_RUNTIME=1");
   end Linker;

end HAC_CLI;
