with "../sdl3_common.gpr";

project Basic is

   for Target use SDL3_Common'Target;
   for Runtime ("Ada") use SDL3_Common'Runtime ("Ada");
   for Object_Dir use ".objs";
   for Exec_Dir use ".";
   for Source_Dirs use (".", "../bindings", ".objs");
   for Main use ("sdl3_ada_main.adb");

   package Compiler renames SDL3_Common.Compiler;

   package Builder is
      for Executable ("sdl3_ada_main.adb") use "basic.html";
   end Builder;

   package Linker extends SDL3_Common.Linker is
      for Switches ("Ada") use
        SDL3_Common.Linker_Switches
        & (SDL3_Common.SDL3_Lib);
   end Linker;

end Basic;
