with "../sdl3_common.gpr";

project Image is

   for Target use SDL3_Common'Target;
   for Runtime ("Ada") use SDL3_Common'Runtime ("Ada");
   for Object_Dir use ".objs";
   for Exec_Dir use ".";
   for Source_Dirs use (".", "../bindings", ".objs");
   for Main use ("sdl3_image_main.adb");

   package Compiler renames SDL3_Common.Compiler;

   package Builder is
      for Executable ("sdl3_image_main.adb") use "image.html";
   end Builder;

   package Linker extends SDL3_Common.Linker is
      for Switches ("Ada") use
        SDL3_Common.Linker_Switches
        & ("--embed-file",
            Project'Project_Dir & "ada-strong-2022-256-color.png@/ada-strong-2022-256-color.png")
        & (SDL3_Common.SDL3_Image_Lib, SDL3_Common.SDL3_Lib);
   end Linker;

end Image;
